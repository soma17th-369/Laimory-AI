{
  "policies": [
    {
      "policyId": "FINANCE_PAYMENT",
      "domain": "금융·결제",
      "provides": [
        "PAYMENT"
      ],
      "information": "카드·은행·간편결제 앱의 결제 알림이다. 결제·승인·환불·취소 사실과 가맹점, 금액, 승인 시각을 얻을 수 있다.",
      "titleMeaning": "카드사·은행·결제 서비스 이름이거나 알림 종류다.",
      "textMeaning": "가맹점, 금액, 승인·환불·취소 여부가 담긴 거래 안내다."
    },
    {
      "policyId": "SHOPPING_DELIVERY",
      "domain": "쇼핑·택배",
      "provides": [
        "PAYMENT",
        "RESERVATION"
      ],
      "information": "쇼핑몰·택배 앱의 주문·배송 알림이다. 무엇을 주문·환불·취소했는지와 언제 배송·도착·픽업되는지를 얻을 수 있다.",
      "titleMeaning": "쇼핑몰·택배사 이름이거나 주문·배송 상태다.",
      "textMeaning": "상품, 주문·배송·도착·픽업 상태와 예정 시각이 담긴 안내다."
    },
    {
      "policyId": "RESERVATION_CULTURE",
      "domain": "예약·문화",
      "provides": [
        "RESERVATION"
      ],
      "information": "숙소·공연·영화·식당·병원 예약 앱의 알림이다. 무엇을 언제 어디로 예약·예매·취소했는지를 얻을 수 있다.",
      "titleMeaning": "예약 서비스 이름이거나 예약 상태다.",
      "textMeaning": "예약 대상, 방문·이용 날짜와 시각, 장소, 예약·취소 여부가 담긴 안내다."
    },
    {
      "policyId": "TRANSIT_TRAVEL",
      "domain": "이동·여행",
      "provides": [
        "RESERVATION"
      ],
      "information": "항공·철도·택시·차량 공유·내비게이션 앱의 알림이다. 교통편 예약·취소와 출발·탑승·도착 시각, 출발지·도착지를 얻을 수 있다.",
      "titleMeaning": "교통·여행 서비스 이름이거나 예약·운행 상태다.",
      "textMeaning": "교통편, 출발·도착 시각, 출발지·도착지, 탑승·예약·취소 여부가 담긴 안내다."
    },
    {
      "policyId": "FOOD_CAFE",
      "domain": "배달·카페",
      "provides": [
        "PAYMENT",
        "RESERVATION"
      ],
      "information": "배달·카페·패스트푸드 앱의 주문 알림이다. 어느 매장에서 무엇을 주문·취소했는지와 언제 픽업·배달 도착하는지를 얻을 수 있다.",
      "titleMeaning": "매장·배달 서비스 이름이거나 주문 상태다.",
      "textMeaning": "주문 메뉴, 매장, 주문·픽업·배달 도착·취소 여부와 시각이 담긴 안내다."
    },
    {
      "policyId": "SMS",
      "domain": "문자",
      "provides": [
        "PAYMENT",
        "RESERVATION"
      ],
      "information": "문자로 오는 결제·주문·배송·예약·교통 안내에서 그 정보를 얻을 수 있다. 기관 안내나 사람이 보낸 문자도 같은 앱으로 들어온다.",
      "titleMeaning": "발신번호 또는 발신자 이름이다.",
      "textMeaning": "문자 본문이다. 결제·주문·배송·예약·교통 안내가 많지만 그렇지 않은 문자도 있다."
    },
    {
      "policyId": "MESSENGER",
      "domain": "개인 메신저",
      "provides": [
        "CONVERSATION",
        "PAYMENT",
        "RESERVATION"
      ],
      "information": "사람과 주고받은 사적인 대화가 대부분이다. 가게·서비스가 메신저로 보내는 예약·결제·배송 안내(카카오톡 알림톡 등)도 같은 앱으로 온다. 어느 쪽인지는 메시지 내용으로 가린다.",
      "titleMeaning": "대화 상대다. 1:1 대화면 상대 이름, 단체 대화방이면 대개 메시지를 보낸 사람이며, 앱에 따라 대화방·채널·스페이스 이름이 함께 온다. 안내 메시지면 보낸 가게·서비스 이름이다.",
      "textMeaning": "받은 메시지 본문이다. 대화일 수도 있고 예약·결제·배송 안내일 수도 있다."
    },
    {
      "policyId": "WORK_MESSENGER",
      "domain": "업무 메신저",
      "provides": [
        "CONVERSATION",
        "RESERVATION"
      ],
      "information": "업무·교육 대화가 대부분이다. 회의 시작·초대 안내도 같은 앱으로 온다. 사적인 대화보다 일·수업 맥락으로 읽는다.",
      "titleMeaning": "대화 상대이거나 채널·스페이스 이름이다. `일반: 박천웅`처럼 방 이름과 보낸 사람이 함께 오기도 한다.",
      "textMeaning": "받은 메시지 본문이다. 업무·교육 대화이거나 회의 안내다."
    }
  ],
