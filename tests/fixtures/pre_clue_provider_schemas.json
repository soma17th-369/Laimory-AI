{
  "TimelineAgentOutput": {
    "$defs": {
      "EventSourceType": {
        "description": "AI Event 후보가 참조하는 근거 source 도메인.",
        "enum": [
          "STAY",
          "MOVEMENT",
          "CALENDAR",
          "PHOTO",
          "SLEEP",
          "ACTIVITY",
          "NOTIFICATION"
        ],
        "title": "EventSourceType",
        "type": "string"
      },
      "EventType": {
        "description": "AI Event 후보 종류.",
        "enum": [
          "WAKE_UP",
          "SLEEP",
          "MOVEMENT",
          "CALENDAR_EVENT",
          "MEAL",
          "PHOTO_MOMENT",
          "MEETING",
          "CLASS",
          "WORK",
          "EXERCISE",
          "SOCIAL",
          "REST",
          "UNKNOWN"
        ],
        "title": "EventType",
        "type": "string"
      },
      "InferenceLevel": {
        "description": "후보가 만들어진 추론 수준.",
        "enum": [
          "DIRECT",
          "EVIDENCE_BASED",
          "INFERRED",
          "UNCERTAIN"
        ],
        "title": "InferenceLevel",
        "type": "string"
      },
      "SourceRef": {
        "additionalProperties": false,
        "description": "후보 또는 draft event의 근거 source 참조.",
        "properties": {
          "sourceType": {
            "$ref": "#/$defs/EventSourceType"
          },
          "rawId": {
            "title": "Rawid",
            "type": "string"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "이 source가 후보 또는 draft event의 근거가 되는 이유",
            "title": "Reason"
          }
        },
        "required": [
          "sourceType",
          "rawId"
        ],
        "title": "SourceRef",
        "type": "object"
      },
      "TimelineAgentEvent": {
        "description": "Timeline Agent(LLM)가 쓰는 event 한 건. 코드가 덧붙이는 필드는 여기 없다.",
        "properties": {
          "eventType": {
            "$ref": "#/$defs/EventType"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "description": {
            "default": "",
            "title": "Description",
            "type": "string"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Address"
          },
          "place": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Place"
          },
          "tags": {
            "items": {
              "type": "string"
            },
            "title": "Tags",
            "type": "array"
          },
          "startTime": {
            "format": "date-time",
            "title": "Starttime",
            "type": "string"
          },
          "endTime": {
            "format": "date-time",
            "title": "Endtime",
            "type": "string"
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "inferenceLevel": {
            "$ref": "#/$defs/InferenceLevel"
          },
          "sourceRefs": {
            "items": {
              "$ref": "#/$defs/SourceRef"
            },
            "minItems": 1,
            "title": "Sourcerefs",
            "type": "array"
          },
          "uncertainty": {
            "items": {
              "type": "string"
            },
            "title": "Uncertainty",
            "type": "array"
          }
        },
        "required": [
          "eventType",
          "title",
          "startTime",
          "endTime",
          "confidence",
          "inferenceLevel",
          "sourceRefs"
        ],
        "title": "TimelineAgentEvent",
        "type": "object"
      },
      "TimelineWarning": {
        "description": "Recoverable quality warning for a generated draft.",
        "properties": {
          "warningId": {
            "minLength": 1,
            "title": "Warningid",
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/TimelineWarningSeverity",
            "default": "MEDIUM"
          },
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "sourceRefs": {
            "items": {
              "$ref": "#/$defs/SourceRef"
            },
            "title": "Sourcerefs",
            "type": "array"
          }
        },
        "required": [
          "warningId",
          "message"
        ],
        "title": "TimelineWarning",
        "type": "object"
      },
      "TimelineWarningSeverity": {
        "description": "Warning severity for a recoverable draft quality issue.",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH"
        ],
        "title": "TimelineWarningSeverity",
        "type": "string"
      }
    },
    "description": "Timeline Agent 의 LLM 출력 계약(#118).\n\n``warnings`` 는 Timeline 만 아는 판단 — 근거가 충돌해 한쪽을 고른 곳, 일부러 쓰지\n않은 근거와 그 이유 — 을 담는다. Agent 실패·sourceRefs 누락·민감정보처럼 코드가\n이미 남기는 것은 여기 적을 이유가 없다.",
    "properties": {
      "events": {
        "items": {
          "$ref": "#/$defs/TimelineAgentEvent"
        },
        "title": "Events",
        "type": "array"
      },
      "warnings": {
        "items": {
          "$ref": "#/$defs/TimelineWarning"
        },
        "title": "Warnings",
        "type": "array"
      }
    },
    "title": "TimelineAgentOutput",
    "type": "object"
  },
